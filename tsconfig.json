{
  // Type-checking ONLY — esbuild does the emit and strips types without looking at them. Without this, the shim can
  // disagree with the ABI the platform generated for it and nothing says so until a browser.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  // `scripts/` is Node build tooling, not shim source, and the kit's own build output is not TypeScript at all.
  "include": ["*.ts", "*.d.ts"]
}

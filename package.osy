// Osysharp.BarcodeScanner as a package — the kit whose chunk is WebAssembly.
//
// The `.wasm` needs no special mechanism: it is an ordinary chunk, carried by a `controls` entry and verified against
// the kit's own `osyrin.lock` like every other asset. A package archive is a container of bytes, and nothing in the
// format cares what a member holds.
package Osysharp.BarcodeScanner {
  version "1.0.2";
  minPlatform "0.9.0";
  contract    "1.1";
  summary     "a live barcode + QR scanner: it owns the camera, decoding with ZXing.";

  model    "*.osy";
  controls "osyrin.lock";
  controls "scan.js";
  controls "zxing-core.js";
  controls "zxing-reader.wasm";
}
